{
  "name": "bays",
  "displayName": "Bays",
  "description": "Your open editors as a vertical list in the sidebar, with groups, variants and git state.",
  "version": "0.3.7",
  "publisher": "Kailuss",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#1F2430",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Kailuss/bays.git"
  },
  "bugs": {
    "url": "https://github.com/Kailuss/bays/issues"
  },
  "homepage": "https://github.com/Kailuss/bays#readme",
  "engines": {
    "vscode": "^1.85.0",
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "tabs",
    "editors",
    "sidebar",
    "vertical tabs",
    "open editors"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true,
      "description": "Bays only reads the list of open editors and their git and diagnostic state. It never runs code from the workspace."
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Bays works in a virtual workspace. File actions that need a file on disk, and git state, are not available there."
    }
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "baysContainer",
          "title": "Bays",
          "icon": "$(files)"
        }
      ]
    },
    "views": {
      "baysContainer": [
        {
          "type": "webview",
          "id": "bays",
          "name": "Bays",
          "icon": "./icon.png"
        }
      ]
    },
    "commands": [
      {
        "command": "bays.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Bays"
      },
      {
        "command": "bays.openBay",
        "title": "Open Bay",
        "category": "Bays"
      },
      {
        "command": "bays.closeBay",
        "title": "Close Bay",
        "icon": "$(close)",
        "category": "Bays"
      },
      {
        "command": "bays.closeOthers",
        "title": "Close Others",
        "category": "Bays"
      },
      {
        "command": "bays.closeToRight",
        "title": "Close to the Right",
        "category": "Bays"
      },
      {
        "command": "bays.closeAll",
        "title": "Close All",
        "icon": "$(close-all)",
        "category": "Bays"
      },
      {
        "command": "bays.pinBay",
        "title": "Pin Bay",
        "icon": "$(pinned)",
        "category": "Bays"
      },
      {
        "command": "bays.unpinBay",
        "title": "Unpin Bay",
        "icon": "$(pin)",
        "category": "Bays"
      },
      {
        "command": "bays.revealInExplorer",
        "title": "Reveal in Explorer",
        "icon": "$(go-to-file)",
        "category": "Bays"
      },
      {
        "command": "bays.copyRelativePath",
        "title": "Copy Relative Path",
        "icon": "$(clippy)",
        "category": "Bays"
      },
      {
        "command": "bays.copyFileContents",
        "title": "Copy File Contents",
        "icon": "$(copy)",
        "category": "Bays"
      },
      {
        "command": "bays.compareWithActive",
        "title": "Compare with Active Editor",
        "icon": "$(diff)",
        "category": "Bays"
      },
      {
        "command": "bays.moveToGroup",
        "title": "Move to Group…",
        "icon": "$(split-horizontal)",
        "category": "Bays"
      },
      {
        "command": "bays.addToCopilotChat",
        "title": "Add to Copilot Chat",
        "icon": "$(add)",
        "category": "Bays"
      },
      {
        "command": "bays.addMultipleToCopilotChat",
        "title": "Add Files to Copilot Chat…",
        "icon": "$(sparkle)",
        "category": "Bays"
      },
      {
        "command": "bays.closeGroup",
        "title": "Close Group",
        "icon": "$(close-all)",
        "category": "Bays"
      },
      {
        "command": "bays.copyPath",
        "title": "Copy Path",
        "icon": "$(copy)",
        "category": "Bays"
      },
      {
        "command": "bays.openTimeline",
        "title": "Open Timeline",
        "icon": "$(history)",
        "category": "Bays"
      },
      {
        "command": "bays.splitRight",
        "title": "Split Right",
        "icon": "$(split-horizontal)",
        "category": "Bays"
      },
      {
        "command": "bays.openChanges",
        "title": "Open Changes",
        "icon": "$(git-compare)",
        "category": "Bays"
      },
      {
        "command": "bays.revealInFileExplorer",
        "title": "Reveal in File Explorer",
        "icon": "$(folder-opened)",
        "category": "Bays"
      },
      {
        "command": "bays.moveToNewWindow",
        "title": "Move to New Window",
        "icon": "$(multiple-windows)",
        "category": "Bays"
      },
      {
        "command": "bays.duplicateFile",
        "title": "Duplicate File",
        "icon": "$(files)",
        "category": "Bays"
      },
      {
        "command": "bays.saveAll",
        "title": "Save All",
        "icon": "$(save-all)",
        "category": "Bays"
      },
      {
        "command": "bays.reorder",
        "title": "Reorder Bays",
        "icon": "$(list-ordered)",
        "category": "Bays"
      },
      {
        "command": "bays.toggleCompactMode",
        "title": "Toggle Compact Mode",
        "icon": "$(collapse-all)",
        "category": "Bays"
      },
      {
        "command": "bays.toggleShowPath",
        "title": "Toggle View Path",
        "icon": "$(list-selection)",
        "category": "Bays"
      },
      {
        "command": "bays.renameGroup",
        "title": "Rename Group…",
        "icon": "$(edit)",
        "category": "Bays"
      },
      {
        "command": "bays.setGroupColor",
        "title": "Set Group Color…",
        "icon": "$(symbol-color)",
        "category": "Bays"
      },
      {
        "command": "bays.toggleGroupLock",
        "title": "Toggle Group Lock",
        "icon": "$(lock)",
        "category": "Bays"
      }
    ],
    "submenus": [
      {
        "id": "bays.viewOptions",
        "label": "View Options",
        "icon": "$(settings)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "bays.openBay",
          "when": "false"
        },
        {
          "command": "bays.closeBay",
          "when": "false"
        },
        {
          "command": "bays.closeOthers",
          "when": "false"
        },
        {
          "command": "bays.closeToRight",
          "when": "false"
        },
        {
          "command": "bays.pinBay",
          "when": "false"
        },
        {
          "command": "bays.unpinBay",
          "when": "false"
        },
        {
          "command": "bays.revealInExplorer",
          "when": "false"
        },
        {
          "command": "bays.copyRelativePath",
          "when": "false"
        },
        {
          "command": "bays.copyFileContents",
          "when": "false"
        },
        {
          "command": "bays.compareWithActive",
          "when": "false"
        },
        {
          "command": "bays.moveToGroup",
          "when": "false"
        },
        {
          "command": "bays.addToCopilotChat",
          "when": "false"
        },
        {
          "command": "bays.closeGroup",
          "when": "false"
        },
        {
          "command": "bays.copyPath",
          "when": "false"
        },
        {
          "command": "bays.openTimeline",
          "when": "false"
        },
        {
          "command": "bays.splitRight",
          "when": "false"
        },
        {
          "command": "bays.openChanges",
          "when": "false"
        },
        {
          "command": "bays.revealInFileExplorer",
          "when": "false"
        },
        {
          "command": "bays.moveToNewWindow",
          "when": "false"
        },
        {
          "command": "bays.duplicateFile",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "bays.saveAll",
          "when": "view == bays && bays.hasUnsavedBays",
          "group": "navigation@1"
        },
        {
          "submenu": "bays.viewOptions",
          "when": "view == bays",
          "group": "navigation@2"
        }
      ],
      "bays.viewOptions": [
        {
          "command": "bays.toggleCompactMode",
          "group": "1_toggles@1"
        },
        {
          "command": "bays.toggleShowPath",
          "group": "1_toggles@2"
        }
      ]
    },
    "configuration": {
      "title": "Bays",
      "properties": {
        "bays.showFilePath": {
          "type": "boolean",
          "default": true,
          "description": "Show the relative file path as description next to each bay."
        },
        "bays.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable compact mode: bays show file name and path in a single line with reduced height (28px)."
        },
        "bays.enableHoverActions": {
          "type": "boolean",
          "default": true,
          "description": "Show action buttons (file actions, Copilot, close) when hovering over a bay."
        },
        "bays.enableDragDrop": {
          "type": "boolean",
          "default": true,
          "description": "Enable drag & drop reordering of bays within and across groups."
        },
        "bays.syncCursorPosition": {
          "type": "boolean",
          "default": false,
          "description": "Synchronize cursor position (line and column) between parent bays and their children (diffs, snapshots, etc.). When enabled, moving the cursor in one bay will update all related bays."
        },
        "bays.animations": {
          "type": "boolean",
          "default": true,
          "description": "Master switch for everything the view moves: the close animation, the state-change pulse and the tooltip fade. It is also turned off by `workbench.reduceMotion`."
        },
        "bays.followProductIconTheme": {
          "type": "boolean",
          "default": true,
          "description": "Draw the panel's glyphs with the product icon theme selected in `workbench.productIconTheme`, like the rest of the workbench. Off, the panel keeps the codicons the extension ships, and nothing is read from disk."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && npm run test && npm run check-docs && npm run check-layers && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "watch:tsc-webview": "tsc --noEmit --watch --project src/webview/tsconfig.json",
    "package": "npm run check-types && npm run lint && npm run test && npm run check-docs && npm run check-layers && npm run check-release && node esbuild.js --production",
    "check-types": "tsc --noEmit && tsc --noEmit -p src/webview/tsconfig.json",
    "check-docs": "node scripts/check-docs.js",
    "check-layers": "node scripts/check-layers.js",
    "check-release": "node scripts/check-release.js",
    "vsix": "node scripts/release.js package",
    "release": "node scripts/release.js publish",
    "lint": "eslint src",
    "test": "node esbuild.js --tests && node --test \"out/test/*.test.js\"",
    "compile-tests": "tsc -p tsconfig.integration.json --outDir out",
    "test:integration": "npm run compile-tests && node esbuild.js && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.44",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
