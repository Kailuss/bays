{
  "name": "bays",
  "displayName": "Bays",
  "description": "Vertical bays panel with advanced features",
  "version": "0.3.3",
  "publisher": "Kailuss",
  "repository": {
    "type": "git",
    "url": "https://github.com/Kailuss/bays.git"
  },
  "bugs": {
    "url": "https://github.com/Kailuss/bays/issues"
  },
  "homepage": "https://github.com/Kailuss/bays#readme",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "baysContainer",
          "title": "Bays",
          "icon": "$(files)"
        }
      ]
    },
    "views": {
      "baysContainer": [
        {
          "type" : "webview",
          "id"   : "bays",
          "name" : "Bays",
          "icon" : "./icon.png"
        }
      ]
    },
    "commands": [
      {
        "command"  :"bays.refresh",
        "title"    :"Refresh",
        "icon"     :"$(refresh)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.openBay",
        "title"    :"Open Bay",
        "category" :"Bays"
      },
      {
        "command"  :"bays.closeBay",
        "title"    :"Close Bay",
        "icon"     :"$(close)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.closeOthers",
        "title"    :"Close Others",
        "category" :"Bays"
      },
      {
        "command"  :"bays.closeToRight",
        "title"    :"Close to the Right",
        "category" :"Bays"
      },
      {
        "command"  :"bays.closeAll",
        "title"    :"Close All",
        "icon"     :"$(close-all)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.pinBay",
        "title"    :"Pin Bay",
        "icon"     :"$(pinned)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.unpinBay",
        "title"    :"Unpin Bay",
        "icon"     :"$(pin)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.revealInExplorer",
        "title"    :"Reveal in Explorer",
        "icon"     :"$(go-to-file)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.copyRelativePath",
        "title"    :"Copy Relative Path",
        "icon"     :"$(clippy)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.copyFileContents",
        "title"    :"Copy File Contents",
        "icon"     :"$(copy)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.compareWithActive",
        "title"    :"Compare with Active Editor",
        "icon"     :"$(diff)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.moveToGroup",
        "title"    :"Move to Group…",
        "icon"     :"$(split-horizontal)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.addToCopilotChat",
        "title"    :"Add to Copilot Chat",
        "icon"     :"$(add)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.addMultipleToCopilotChat",
        "title"    :"Add Files to Copilot Chat…",
        "icon"     :"$(sparkle)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.closeGroup",
        "title"    :"Close Group",
        "icon"     :"$(close-all)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.copyPath",
        "title"    :"Copy Path",
        "icon"     :"$(copy)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.openTimeline",
        "title"    :"Open Timeline",
        "icon"     :"$(history)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.splitRight",
        "title"    :"Split Right",
        "icon"     :"$(split-horizontal)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.openChanges",
        "title"    :"Open Changes",
        "icon"     :"$(git-compare)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.revealInFileExplorer",
        "title"    :"Reveal in File Explorer",
        "icon"     :"$(folder-opened)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.revealInExplorerView",
        "title"    :"Reveal in Explorer View",
        "icon"     :"$(files)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.moveToNewWindow",
        "title"    :"Move to New Window",
        "icon"     :"$(multiple-windows)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.duplicateFile",
        "title"    :"Duplicate File",
        "icon"     :"$(files)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.saveAll",
        "title"    :"Save All",
        "icon"     :"$(save-all)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.reorder",
        "title"    :"Reorder Bays",
        "icon"     :"$(list-ordered)",
        "category" :"Bays"
      },
      {
        "command"  :"bays.toggleCompactMode",
        "title"    :"Toggle Compact Mode",
        "icon"     :"$(list-flat)",
        "category" :"Bays"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "bays.refresh",
          "when": "view == bays",
          "group": "navigation@1"
        },
        {
          "command": "bays.reorder",
          "when": "view == bays",
          "group": "navigation@2"
        },
        {
          "command": "bays.toggleCompactMode",
          "when": "view == bays",
          "group": "navigation@3"
        },
        {
          "command": "bays.saveAll",
          "when": "view == bays",
          "group": "navigation@4"
        },
        {
          "command": "bays.addMultipleToCopilotChat",
          "when": "view == bays && bays.copilotAvailable",
          "group": "navigation@5"
        }
      ]
    },
    "configuration": {
      "title": "Bays",
      "properties": {
        "bays.showFilePath": {
          "type": "boolean",
          "default": true,
          "description": "Show the relative file path as description next to each bay."
        },
        "bays.compactMode": {
          "type": "boolean",
          "default": false,
          "description": "Enable compact mode: bays show file name and path in a single line with reduced height (28px)."
        },
        "bays.iconSize": {
          "type": "number",
          "default": 16,
          "description": "Size of the file icon in pixels."
        },
        "bays.enableHoverActions": {
          "type": "boolean",
          "default": true,
          "description": "Show action buttons when hovering over a bay."
        },
        "bays.showStateIcons": {
          "type": "boolean",
          "default": true,
          "description": "Show state icons (pinned, modified, Copilot-edited) on bays."
        },
        "bays.enableDragDrop": {
          "type": "boolean",
          "default": true,
          "description": "Enable drag & drop reordering of bays within and across groups."
        },
        "bays.syncCursorPosition": {
          "type": "boolean",
          "default": false,
          "description": "Synchronize cursor position (line and column) between parent bays and their children (diffs, snapshots, etc.). When enabled, moving the cursor in one bay will update all related bays."
        },
        "bays.openPreviewableInPreview": {
          "type": "boolean",
          "default": true,
          "description": "Automatically open previewable files (Markdown, HTML, etc.) in preview mode when first opened."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/chai": "^5.2.3",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/uuid": "^10.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "chai": "^6.2.2",
    "esbuild": "^0.27.2",
    "eslint": "^9.39.2",
    "mocha": "^11.7.5",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.44",
    "uuid": "^13.0.0"
  }
}
